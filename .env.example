NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
GRAPHQL_SANDBOX_ENABLED=true
CORS_ORIGINS=http://localhost:3001

DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE_NAME"
DB_POOL_MIN=2
DB_POOL_MAX=10
KNEX_DEBUG=false

JWT_ACCESS_SECRET=change_me_access_secret_at_least_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_refresh_secret_at_least_32_chars
JWT_REFRESH_EXPIRES_IN=7d

REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
CACHE_TTL_SECONDS=60

KAFKA_ENABLED=false
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=graphql-knex
KAFKA_CONSUMER_GROUP_ID=graphql-knex-consumers
KAFKA_SSL=false
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
