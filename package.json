{
  "name": "graphql-knex",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build && tsc-alias -p tsconfig.build.json",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "npm run build && node dist/main.js",
    "lint": "oxlint src/ test/",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "VITE_CONFIG_NATIVE_IGNORE_WARNING=true SWC_NATIVE_BINDING_CACHE=$PWD/.cache/swc-native vitest run",
    "test:watch": "VITE_CONFIG_NATIVE_IGNORE_WARNING=true SWC_NATIVE_BINDING_CACHE=$PWD/.cache/swc-native vitest",
    "test:cov": "VITE_CONFIG_NATIVE_IGNORE_WARNING=true SWC_NATIVE_BINDING_CACHE=$PWD/.cache/swc-native vitest run --coverage",
    "test:debug": "VITE_CONFIG_NATIVE_IGNORE_WARNING=true SWC_NATIVE_BINDING_CACHE=$PWD/.cache/swc-native vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "VITE_CONFIG_NATIVE_IGNORE_WARNING=true SWC_NATIVE_BINDING_CACHE=$PWD/.cache/swc-native vitest run --config ./vitest.config.e2e.ts",
    "knex": "knex --knexfile dist/database/knexfile.js",
    "migration:make": "npm run build && npm run knex -- migrate:make -x ts --migrations-directory src/database/migrations",
    "migration:latest": "npm run build && npm run migration:latest:prod",
    "migration:latest:prod": "knex --knexfile dist/database/knexfile.js migrate:latest",
    "migration:rollback": "npm run build && npm run knex -- migrate:rollback",
    "migration:status": "npm run build && npm run knex -- migrate:status",
    "seed:run": "npm run build && npm run knex -- seed:run"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@nestjs/apollo": "^14.0.3",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/graphql": "^14.0.3",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/microservices": "^12.1.2",
    "@nestjs/observe": "^0.1.8",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/throttler": "^6.7.1",
    "argon2": "^0.45.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compression": "^1.8.2",
    "dataloader": "^2.2.3",
    "dotenv": "^18.0.6",
    "graphql": "^16.14.2",
    "graphql-depth-limit": "^1.1.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "joi": "^18.2.9",
    "kafkajs": "^2.2.4",
    "knex": "^3.3.0",
    "mysql2": "^3.24.5",
    "nestjs-pino": "^5.3.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@swc/core": "^1.16.13",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.0",
    "@types/graphql-depth-limit": "^1.1.6",
    "@types/node": "^24.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "oxlint": "^1.58.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "tsc-alias": "^1.9.7",
    "typescript": "^6.0.2",
    "unplugin-swc": "^2.0.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.2"
  }
}
